# ─────────────────────────────────────────
# Gemini APIキー（必須）
# Google AI Studio (https://aistudio.google.com) で取得してください
# 未設定でもアプリは動きますが、口コミ生成がモック文章になります
# ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# 使用するモデル（gemini-3.6-flash 推奨）
GEMINI_MODEL=gemini-3.6-flash

# 生成のタイムアウト（任意・ミリ秒、省略時は12000）
# 超過するとモック文章へフォールバックします
# GEMINI_TIMEOUT_MS=12000

# ─────────────────────────────────────────
# アプリのURL（Vercelにデプロイ後に設定）
# 例: https://pochikomi.vercel.app
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# トップページに開発用テストリンクを表示する（本番では設定しない）
NEXT_PUBLIC_SHOW_DEV_LINKS=true
